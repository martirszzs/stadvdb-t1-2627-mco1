# Copy this file to .streamlit/secrets.toml and fill in your local MySQL password.
# secrets.toml is git-ignored so each teammate keeps their own credentials.
[mysql]
host = "localhost"
port = 3306
user = "root"
password = "PUT_YOUR_MYSQL_PASSWORD_HERE"
source_db = "financedata"
warehouse_db = "finance_mco1"
